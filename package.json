{
  "name": "aspire-alumni-ebook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --d1 DB=aspire-alumni-db --r2 STORAGE=aspire-alumni-storage --persist",
    "db:init:local": "wrangler d1 execute aspire-alumni-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute aspire-alumni-db --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute aspire-alumni-db --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name aspire-alumni-ebook"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.83.0"
  }
}
